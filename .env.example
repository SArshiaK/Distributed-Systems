DATABASE_URL=postgresql://bankuser:bankpass@127.0.0.1:5432/minibank
MAX_CLIENTS=20
LOG_FILE=bank_server.log
HOST=0.0.0.0
PORT=8000

# Quorum settings for fault-tolerant mode (Section 5 & 6)
ENABLE_QUORUM=false
WITNESS_URL=http://192.168.56.12:9000
PEER_SERVER_URL=http://192.168.56.11:8000

# Lease-based leader election (stronger split-brain protection).
# Enable on BOTH servers; NODE_ID must be unique per server.
ENABLE_LEASE=false
NODE_ID=server-a
LEASE_TTL=6
LEASE_RENEW_INTERVAL=2
