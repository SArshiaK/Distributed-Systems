# Only needed when using docker-compose.registry.yml
# Copy to ".env" next to compose files, or export in the shell.

# GHCR (default in docker-compose.registry.yml)
BANK_IMAGE=ghcr.io/sarshiak/distributed-systems/bank-server:latest
GATEWAY_IMAGE=ghcr.io/sarshiak/distributed-systems/gateway:latest
COORDINATOR_IMAGE=ghcr.io/sarshiak/distributed-systems/coordinator:latest
CONSOLE_IMAGE=ghcr.io/sarshiak/distributed-systems/console:latest
MIGRATOR_IMAGE=ghcr.io/sarshiak/distributed-systems/migrator:latest
HEALER_IMAGE=ghcr.io/sarshiak/distributed-systems/healer:latest

# Docker Hub alternative:
# BANK_IMAGE=YOURUSER/ds2-bank-server:latest
# GATEWAY_IMAGE=YOURUSER/ds2-gateway:latest
# COORDINATOR_IMAGE=YOURUSER/ds2-coordinator:latest
# CONSOLE_IMAGE=YOURUSER/ds2-console:latest
# MIGRATOR_IMAGE=YOURUSER/ds2-migrator:latest
# HEALER_IMAGE=YOURUSER/ds2-healer:latest
